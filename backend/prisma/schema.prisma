generator client {
  provider      = "prisma-client-js"
  output        = "client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserPreference {
  id        String   @id @map("preference_id") @db.VarChar(26)
  userId    String   @map("user_id") @db.VarChar(50)
  language  String   @default("en") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([userId])
  @@map("user_preferences")
}

model PromptTemplate {
  id          String   @id @map("template_id") @db.VarChar(26)
  userId      String   @map("user_id") @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  prompt      String   @db.Text
  type        String   @db.VarChar(50) // "checklist", "review" など
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([userId, name, type])
  @@index([userId, type])
  @@map("prompt_templates")
}

model CheckListSet {
  id          String              @id @map("check_list_set_id") @db.VarChar(26)
  name        String              @db.VarChar(255)
  description String?             @db.Text
  userId      String              @map("user_id") @db.VarChar(50)
  checkLists  CheckList[]
  documents   CheckListDocument[]
  reviewJobs  ReviewJob[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([userId], map: "idx_check_list_sets_user_id")
  @@map("check_list_sets")
}

model ToolConfiguration {
  id              String      @id @map("tool_configuration_id") @db.VarChar(26)
  name            String      @db.VarChar(255)
  description     String?     @db.Text
  knowledgeBase   Json?       @map("knowledge_base")
  codeInterpreter Boolean     @default(false) @map("code_interpreter")
  mcpConfig       Json?       @map("mcp_config")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(0)
  checkLists      CheckList[]

  @@map("tool_configurations")
}

model CheckList {
  id                       String             @id @map("check_id") @db.VarChar(26)
  name                     String             @db.VarChar(255)
  description              String?            @db.Text
  parentId                 String?            @map("parent_id") @db.VarChar(26)
  checkListSetId           String             @map("check_list_set_id") @db.VarChar(26)
  documentId               String?            @map("document_id") @db.VarChar(26)
  ambiguityReview          Json?              @map("ambiguity_review")
  toolConfigurationId      String?            @map("tool_configuration_id") @db.VarChar(26)
  modelId                  String?            @map("model_id") @db.VarChar(255)
  importance               String             @default("medium") @db.VarChar(10)
  feedbackSummary          String?            @map("feedback_summary") @db.Text
  feedbackSummaryUpdatedAt DateTime?          @map("feedback_summary_updated_at") @db.Timestamp(0)
  /// 審査のときに見てほしい観点。人が書く。空なら prompt に何も差し込まない
  reviewGuidance           String?            @map("review_guidance") @db.Text
  /// 着眼点を書いた日時。書く前と後で覆された率を比べるために使う
  reviewGuidanceUpdatedAt  DateTime?          @map("review_guidance_updated_at") @db.Timestamp(0)
  checkListSet             CheckListSet       @relation(fields: [checkListSetId], references: [id])
  document                 CheckListDocument? @relation(fields: [documentId], references: [id])
  parent                   CheckList?         @relation("CheckListToCheckList", fields: [parentId], references: [id])
  children                 CheckList[]        @relation("CheckListToCheckList")
  reviewResults            ReviewResult[]
  toolConfiguration        ToolConfiguration? @relation(fields: [toolConfigurationId], references: [id], onDelete: Restrict)

  /// `parentId` だけで検索するケース（直下の子チェック項目を取得）を高速化
  @@index([parentId], map: "idx_check_list_parent")
  /// `checkListSetId` だけで検索するケース（あるセット配下の全チェック項目を取得）を高速化
  @@index([checkListSetId], map: "check_lists_check_list_set_id_fkey")
  /// `checkListSetId` と `parentId` を**同時に等価条件**で絞り込むクエリが最も多いため複合キーを追加
  /// 例: `findCheckListItems(setId, parentId)`
  @@index([checkListSetId, parentId], map: "idx_check_list_set_parent")
  @@index([toolConfigurationId], map: "idx_check_list_tool_config")
  @@map("check_lists")
}

model CheckListDocument {
  id             String       @id @map("document_id") @db.VarChar(26)
  filename       String       @db.VarChar(255)
  s3Path         String       @map("s3_path") @db.VarChar(512)
  fileType       String       @map("file_type") @db.VarChar(50)
  uploadDate     DateTime     @map("upload_date") @db.Timestamp(0)
  checkListSetId String       @map("check_list_set_id") @db.VarChar(26)
  userId         String?      @map("user_id") @db.VarChar(50)
  status         String       @default("pending") @db.VarChar(20)
  errorDetail    String?      @map("error_detail") @db.Text
  checkLists     CheckList[]
  checkListSet   CheckListSet @relation(fields: [checkListSetId], references: [id])

  @@index([checkListSetId], map: "checklist_documents_check_list_set_id_fkey")
  @@map("checklist_documents")
}

model ReviewDocument {
  id                    String           @id @map("review_document_id") @db.VarChar(26)
  filename              String           @db.VarChar(255)
  s3Path                String           @map("s3_path") @db.VarChar(512)
  fileType              String           @map("file_type") @db.VarChar(50)
  uploadDate            DateTime         @map("upload_date") @db.Timestamp(0)
  userId                String?          @map("user_id") @db.VarChar(50)
  status                String           @default("pending") @db.VarChar(20)
  reviewJobId           String           @map("review_job_id") @db.VarChar(26)
  /// 再審査で、元のジョブから引き継いだ文書（同じ S3 のファイルを指す）
  carriedFromDocumentId String?          @map("carried_from_document_id") @db.VarChar(26)
  /// 再審査で、この文書が差し替えた元のジョブの文書
  replacesDocumentId    String?          @map("replaces_document_id") @db.VarChar(26)
  reviewJob             ReviewJob        @relation(fields: [reviewJobId], references: [id])
  carriedFromDocument   ReviewDocument?  @relation("ReviewDocumentCarriedFrom", fields: [carriedFromDocumentId], references: [id], onDelete: SetNull)
  carriedToDocuments    ReviewDocument[] @relation("ReviewDocumentCarriedFrom")
  replacesDocument      ReviewDocument?  @relation("ReviewDocumentReplaces", fields: [replacesDocumentId], references: [id], onDelete: SetNull)
  replacedByDocuments   ReviewDocument[] @relation("ReviewDocumentReplaces")

  @@index([reviewJobId], map: "review_documents_review_job_id_fkey")
  @@index([carriedFromDocumentId], map: "idx_review_documents_carried_from")
  @@index([replacesDocumentId], map: "idx_review_documents_replaces")
  @@map("review_documents")
}

model ReviewJob {
  id                String           @id @map("review_job_id") @db.VarChar(26)
  name              String           @db.VarChar(255)
  status            String           @default("pending") @db.VarChar(20)
  errorDetail       String?          @map("error_detail") @db.Text
  checkListSetId    String           @map("check_list_set_id") @db.VarChar(26)
  createdAt         DateTime         @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime         @map("updated_at") @db.Timestamp(0)
  completedAt       DateTime?        @map("completed_at") @db.Timestamp(0)
  /// 走っている審査の実行。中止するときに使う。待ち行列にいる間は入らない
  executionArn      String?          @map("execution_arn") @db.VarChar(255)
  /// この審査がどの部署の仕事か。兼務があるので作った人の所属だけでは決まらず、審査ごとに持つ。部署を使わない運用では空
  departmentId      String?          @map("department_id") @db.VarChar(100)
  /// 社内に公開したジョブ。公開しても見られるだけで、判定の変更と削除は作成者のまま
  sharedWithOrg     Boolean          @default(false) @map("shared_with_org")
  userId            String?          @map("user_id") @db.VarChar(50)
  totalInputTokens  Int?             @map("total_input_tokens")
  totalOutputTokens Int?             @map("total_output_tokens")
  totalCost         Decimal?         @map("total_cost") @db.Decimal(10, 4)
  /// 再審査の元になったジョブ。元のジョブが削除されたら NULL になる
  sourceReviewJobId String?          @map("source_review_job_id") @db.VarChar(26)
  /// 再審査で何を直したかのメモ（任意）
  revisionNote      String?          @map("revision_note") @db.Text
  documents         ReviewDocument[]
  checkListSet      CheckListSet     @relation(fields: [checkListSetId], references: [id])
  reviewResults     ReviewResult[]   @relation("ReviewJobResults")
  /// このジョブで下した判定を引き継いだ、再審査ジョブの結果
  judgedResults     ReviewResult[]   @relation("ReviewResultJudgedIn")
  sourceReviewJob   ReviewJob?       @relation("ReviewJobRerun", fields: [sourceReviewJobId], references: [id], onDelete: SetNull)
  rerunJobs         ReviewJob[]      @relation("ReviewJobRerun")

  @@index([checkListSetId], map: "review_jobs_check_list_set_id_fkey")
  @@index([sourceReviewJobId], map: "idx_review_jobs_source_review_job")
  /// 部署で絞る一覧が主な使い道
  @@index([departmentId], map: "idx_review_jobs_department")
  @@map("review_jobs")
}

model ReviewResult {
  id                  String         @id @map("review_result_id") @db.VarChar(26)
  reviewJobId         String         @map("review_job_id") @db.VarChar(26)
  checkId             String         @map("check_id") @db.VarChar(26)
  status              String         @default("pending") @db.VarChar(20)
  result              String?        @db.VarChar(20)
  confidenceScore     Float?         @map("confidence_score")
  explanation         String?        @db.Text
  shortExplanation    String?        @map("short_explanation") @db.VarChar(80)
  extractedText       String?        @map("extracted_text") @db.Text
  userOverride        Boolean        @default(false) @map("user_override")
  userComment         String?        @map("user_comment") @db.Text
  /// AI が下した判定。人が上書きしても変わらない。これがあると「AI が厳しすぎたのか見落としたのか」が分かる。この変更より前の結果には入らない
  aiResult            String?        @map("ai_result") @db.VarChar(20)
  /// 覆した理由。自由記述のコメントとは別に、集計できる形で持つ
  overrideReason      String?        @map("override_reason") @db.VarChar(30)
  /// 覆した人。そのときの表示名（メールアドレス）を控える。あとで登録が変わっても、そのとき誰が決めたかは変わらない
  overriddenBy        String?        @map("overridden_by") @db.VarChar(255)
  /// 覆した日時。updatedAt は審査し直しでも動くので、別に持つ
  overriddenAt        DateTime?      @map("overridden_at") @db.Timestamp(0)
  reviewMeta          Json?          @map("review_meta")
  inputTokens         Int?           @map("input_tokens")
  outputTokens        Int?           @map("output_tokens")
  totalCost           Decimal?       @map("total_cost") @db.Decimal(10, 4)
  createdAt           DateTime       @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime       @map("updated_at") @db.Timestamp(0)
  sourceReferences    Json?          @map("source_references")
  externalSources     Json?          @map("external_sources")
  /// 元のジョブにおける、同じチェック項目の結果。元の結果が削除されたら NULL になる
  previousResultId    String?        @map("previous_result_id") @db.VarChar(26)
  /// 審査せずに元の結果を引き継いだか
  carriedOver         Boolean        @default(false) @map("carried_over")
  /// この判定を下したジョブ（判定に使った文書を持つジョブ）。引き継いだ結果にだけ入る。そのジョブが削除されたら NULL になる
  judgedInReviewJobId String?        @map("judged_in_review_job_id") @db.VarChar(26)
  checkList           CheckList      @relation(fields: [checkId], references: [id])
  reviewJob           ReviewJob      @relation("ReviewJobResults", fields: [reviewJobId], references: [id])
  previousResult      ReviewResult?  @relation("ReviewResultHistory", fields: [previousResultId], references: [id], onDelete: SetNull)
  nextResults         ReviewResult[] @relation("ReviewResultHistory")
  judgedInReviewJob   ReviewJob?     @relation("ReviewResultJudgedIn", fields: [judgedInReviewJobId], references: [id], onDelete: SetNull)

  /// `checkId` 単体で詳細取得する際に使用（`findDetailedReviewResultById` で JOIN される）
  @@index([checkId], map: "review_results_check_id_fkey")
  /// `reviewJobId` 単体でジョブの全結果を集める際に使用。
  @@index([reviewJobId], map: "review_results_review_job_id_fkey")
  /// `reviewJobId` + `status` + `result` を同時に  
  /// フィルタリングするクエリ（`findReviewResultsById`）を高速化。先頭列が `reviewJobId` なので単体検索もカバー。
  @@index([reviewJobId, status, result], map: "idx_review_results_job_status_result")
  /// 子結果の有無チェックで `WHERE reviewJobId = ? AND checkId IN (…)` が発生するため追加
  @@index([reviewJobId, checkId], map: "idx_review_results_job_check")
  @@index([previousResultId], map: "idx_review_results_previous_result")
  @@index([judgedInReviewJobId], map: "idx_review_results_judged_in_job")
  @@map("review_results")
}
